      {
        "use_case": "Immediate feedback while students practise",
        "example": "A student whose sum overflows for INT_MAX + 1 gets that exact input, the expected output and the UBSan message within a minute, and can resubmit.",
        "benefit": "Concrete counter-examples teach more than a bare score."
      },
      {
        "use_case": "Plagiarism and LLM-copy triage",
        "example": "Two submissions with renamed variables reach similarity 0.93 against a 0.85 threshold and are flagged; the instructor checks only those pairs.",
        "benefit": "Review time goes to the suspicious cases only, and no one is penalised automatically."
      },
      {
        "use_case": "Coding-interview and hiring screens",
        "example": "Candidates are ranked by correctness, edge cases and memory safety, with a per-metric explanation for every rejection.",
