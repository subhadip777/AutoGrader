# Local LLM (Ollama) used for test generation and the readability review
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
READABILITY_TIMEOUT_S=180

# Sandbox backend: docker (default, required for real submissions)
#   wsl     - development on Windows without Docker (runs as "nobody" in WSL, no container isolation)
#   process - development on Linux without Docker (same caveat)
AUTOGRADER_SANDBOX=docker
AUTOGRADER_SANDBOX_IMAGE=autograder-sandbox:2
# Containers running at the same time, and grading jobs running at the same time
AUTOGRADER_SANDBOX_SLOTS=1
GRADER_WORKERS=1
